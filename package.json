{
  "name": "wp-eleventy-migrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generic WordPress to Eleventy migration wizard",
  "scripts": {
    "migrate:wp": "node src/main.mjs wizard",
    "migrate:wp:run": "node src/main.mjs run",
    "migrate:wp:gui": "node src/main.mjs serve",
    "audit:visual": "node scripts/visual-audit.mjs",
    "audit:site": "node scripts/visual-audit.mjs --site",
    "translate:missing": "node scripts/translate-missing.mjs",
    "test": "node --test --test-reporter=spec \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0"
  }
}
